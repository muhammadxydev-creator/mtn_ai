# MongoDB Configuration (Cloud or Local)
# For MongoDB Atlas Cloud: mongodb+srv://username:password@cluster.mongodb.net/tgo_api?retryWrites=true&w=majority
# For Local Docker: mongodb://mongoadmin:mongopassword@localhost:27017/tgo_api?authSource=admin
MONGODB_URL=mongodb://mongoadmin:mongopassword@localhost:27017/tgo_api?authSource=admin
MONGODB_DB_NAME=tgo_api

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars

# Redis
REDIS_URL=redis://localhost:6379/0

# Internal Service Configuration
INTERNAL_SERVICE_HOST=0.0.0.0
INTERNAL_SERVICE_PORT=8001

# External Service URLs (adjust as needed)
RAG_SERVICE_URL=http://localhost:8001
AI_SERVICE_URL=http://localhost:8002
PLATFORM_SERVICE_URL=http://localhost:8003
WUKONGIM_API_URL=http://localhost:5001

# Optional: GeoIP
GEOIP_LICENSE_KEY=your_geoip_license_key_here

# Optional: Storage (Aliyun OSS, MinIO, S3, etc.)
STORAGE_TYPE=local
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
